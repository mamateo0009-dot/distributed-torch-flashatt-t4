# Multi-stage build for minimal Rust binary container
FROM rust:1.78-bookworm as builder
WORKDIR /usr/src/pearl-proxy
COPY pearl-proxy/ .
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /usr/src/pearl-proxy/target/release/pearl-proxy /app/pearl-proxy

EXPOSE 8000
ENTRYPOINT ["/app/pearl-proxy"]
CMD ["--listen", "0.0.0.0:8000", "--pool", "pearl-eu1.luckypool.io", "--pool-port", "3360"]
